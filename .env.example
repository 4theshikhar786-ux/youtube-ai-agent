# Gemini API key from Google AI Studio. Required.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# YouTube Data API v3 key from Google Cloud Console. Required.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN
YOUTUBE_CATEGORY_ID=28
YOUTUBE_MAX_RESULTS=10

# Google service account JSON file path for Google Docs/Drive. Required.
GOOGLE_DOCS_CREDENTIALS_PATH=service-account.json
GOOGLE_DOCS_FOLDER_ID=

# Telegram bot credentials. Required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Agent defaults.
DEFAULT_NICHE=AI tools, technology, productivity, and online earning
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
